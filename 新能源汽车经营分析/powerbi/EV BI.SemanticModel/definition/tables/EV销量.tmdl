table EV销量
	lineageTag: 3fef8139-7dd1-4ddf-8aad-d1c67793d255

	/// 当前筛选上下文中，数据集最晚月份的销量。用于“当月销量”KPI。
	measure 最晚月销量 =
			
			VAR LatestMonth =
			    CALCULATE(
			        MAX('EV销量'[时间]),
			        REMOVEFILTERS('EV销量'[时间])
			    )
			RETURN
			    CALCULATE(
			        SUM('EV销量'[销量]),
			        REMOVEFILTERS('EV销量'[时间]),
			        'EV销量'[时间] = LatestMonth
			    )
		formatString: #,0
		displayFolder: 核心KPI\销量
		lineageTag: b4ac0089-db0f-4d2c-b382-cb8e8f1c9da9

		changedProperty = IsHidden

	/// 当前筛选上下文中，数据集第二晚月份的销量。仅供环比增长率计算使用。
	measure 第二晚月销量 =
			
			VAR LatestMonth =
			    CALCULATE(
			        MAX('EV销量'[时间]),
			        REMOVEFILTERS('EV销量'[时间])
			    )
			VAR PreviousMonth1 =
			    CALCULATE(
			        MAX('EV销量'[时间]),
			        FILTER(
			            ALL('EV销量'[时间]),
			            'EV销量'[时间] < LatestMonth
			        )
			    )
			RETURN
			    CALCULATE(
			        SUM('EV销量'[销量]),
			        REMOVEFILTERS('EV销量'[时间]),
			        'EV销量'[时间] = PreviousMonth1
			    )
		formatString: #,0
		displayFolder: 辅助指标
		lineageTag: 95161cd8-513d-4459-89a7-24492440b938

		changedProperty = IsHidden

	/// 最晚月销量相对上一年同月销量的增长率。
	measure 同比增长率 =
			
			DIVIDE(
			    [最晚月销量] - [前一年同月销量],
			    [前一年同月销量]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 核心KPI\增长
		lineageTag: 776a5ba9-106b-47dd-b946-f2a30cec4815

		changedProperty = IsHidden

	/// 当前筛选上下文中，最晚月份对应的上一年同月销量。仅供同比增长率计算使用。
	measure 前一年同月销量 =
			
			VAR LatestMonth =
			    CALCULATE(
			        MAX('EV销量'[时间]),
			        REMOVEFILTERS('EV销量'[时间])
			    )
			VAR SameMonthLastYear =
			    EDATE(LatestMonth, -12)
			RETURN
			    CALCULATE(
			        SUM('EV销量'[销量]),
			        REMOVEFILTERS('EV销量'[时间]),
			        'EV销量'[时间] = SameMonthLastYear
			    )
		formatString: #,0
		displayFolder: 辅助指标
		lineageTag: 795ae278-faa4-4b67-9b3e-207229546a06

		changedProperty = IsHidden

	/// 最晚月销量相对第二晚月销量的增长率。
	measure 环比增长率 =
			
			DIVIDE(
			    [最晚月销量] - [第二晚月销量],
			    [第二晚月销量]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 核心KPI\增长
		lineageTag: e225c8cd-bfee-473c-8ecc-de7e82ad8642

		changedProperty = IsHidden

	/// 同比和环比 KPI 使用的零增长目标基准。
	measure 标准 = 0
		formatString: 0.00%
		displayFolder: 辅助指标
		lineageTag: 5a4f3281-835a-4eaf-bef4-73ef59afcc49

		changedProperty = IsHidden

	/// 特斯拉中国按厂商月销量计算的最晚月份排名。
	measure 最晚月特斯拉排名 =
			
			VAR LatestMonth =
			    CALCULATE (
			        MAX ( 'EV销量'[时间] ),
			        ALL ( 'EV销量'[时间] )
			    )
			VAR ManufacturerSales =
			    CALCULATETABLE (
			        SUMMARIZE (
			            'EV销量',
			            'EV销量'[厂商],
			            "SalesValue", SUM ( 'EV销量'[销量] )
			        ),
			        ALL ( 'EV销量'[厂商] ),
			        'EV销量'[时间] = LatestMonth
			    )
			VAR TeslaSales =
			    MAXX (
			        FILTER ( ManufacturerSales, 'EV销量'[厂商] = "特斯拉中国" ),
			        [SalesValue]
			    )
			RETURN
			    RANKX ( ManufacturerSales, [SalesValue], TeslaSales, DESC, DENSE )
		formatString: 0
		displayFolder: 核心KPI\排名
		lineageTag: c100fd5c-5eb8-4910-8cf0-55eb564b37e1

		changedProperty = IsHidden

	/// 特斯拉中国按厂商月销量计算的第二晚月份排名。用于“当月排名”KPI比较。
	measure 第二晚月特斯拉排名 =
			
			VAR LatestMonth =
			    CALCULATE (
			        MAX ( 'EV销量'[时间] ),
			        ALL ( 'EV销量'[时间] )
			    )
			VAR SecondLatestMonth =
			    CALCULATE (
			        MAX ( 'EV销量'[时间] ),
			        FILTER (
			            ALL ( 'EV销量'[时间] ),
			            'EV销量'[时间] < LatestMonth
			        )
			    )
			VAR ManufacturerSales =
			    CALCULATETABLE (
			        SUMMARIZE (
			            'EV销量',
			            'EV销量'[厂商],
			            "SalesValue", SUM ( 'EV销量'[销量] )
			        ),
			        ALL ( 'EV销量'[厂商] ),
			        'EV销量'[时间] = SecondLatestMonth
			    )
			VAR TeslaSales =
			    MAXX (
			        FILTER ( ManufacturerSales, 'EV销量'[厂商] = "特斯拉中国" ),
			        [SalesValue]
			    )
			RETURN
			    RANKX ( ManufacturerSales, [SalesValue], TeslaSales, DESC, DENSE )
		formatString: 0
		displayFolder: 辅助指标
		lineageTag: 5b74d096-56ab-48d4-afe0-2e5563627be6

		changedProperty = IsHidden

	/// 特斯拉中国在数据集最晚月份的销量占该月全部EV厂商销量的比例。
	measure 最晚月特斯拉销量占比 =
			VAR LatestMonth =
			    CALCULATE(
			        MAX('EV销量'[时间]),
			        REMOVEFILTERS('EV销量'[时间]),
			        REMOVEFILTERS('EV销量'[厂商])
			    )
			VAR TeslaSales =
			    CALCULATE(
			        SUM('EV销量'[销量]),
			        REMOVEFILTERS('EV销量'[时间]),
			        REMOVEFILTERS('EV销量'[厂商]),
			        'EV销量'[时间] = LatestMonth,
			        'EV销量'[厂商] = "特斯拉中国"
			    )
			VAR TotalEVSales =
			    CALCULATE(
			        SUM('EV销量'[销量]),
			        REMOVEFILTERS('EV销量'[时间]),
			        REMOVEFILTERS('EV销量'[厂商]),
			        'EV销量'[时间] = LatestMonth
			    )
			RETURN
			    DIVIDE(TeslaSales, TotalEVSales)
		formatString: 0.00%
		displayFolder: 核心KPI\占比
		lineageTag: f879abbb-1225-48f9-bf5f-b93023a70f9a

		changedProperty = IsHidden

	/// 特斯拉中国在数据集第二晚月份的销量占该月全部EV厂商销量的比例。用于占比KPI比较。
	measure 第二晚月特斯拉销量占比 =
			VAR LatestMonth =
			    CALCULATE(
			        MAX('EV销量'[时间]),
			        REMOVEFILTERS('EV销量'[时间]),
			        REMOVEFILTERS('EV销量'[厂商])
			    )
			VAR SecondLatestMonth =
			    CALCULATE(
			        MAX('EV销量'[时间]),
			        FILTER(
			            ALL('EV销量'[时间]),
			            'EV销量'[时间] < LatestMonth
			        ),
			        REMOVEFILTERS('EV销量'[厂商])
			    )
			VAR TeslaSales =
			    CALCULATE(
			        SUM('EV销量'[销量]),
			        REMOVEFILTERS('EV销量'[时间]),
			        REMOVEFILTERS('EV销量'[厂商]),
			        'EV销量'[时间] = SecondLatestMonth,
			        'EV销量'[厂商] = "特斯拉中国"
			    )
			VAR TotalEVSales =
			    CALCULATE(
			        SUM('EV销量'[销量]),
			        REMOVEFILTERS('EV销量'[时间]),
			        REMOVEFILTERS('EV销量'[厂商]),
			        'EV销量'[时间] = SecondLatestMonth
			    )
			RETURN
			    DIVIDE(TeslaSales, TotalEVSales)
		formatString: 0.00%
		displayFolder: 辅助指标
		lineageTag: 51de5a18-1793-43b6-98bb-5e3e052ef9f2

		changedProperty = IsHidden

	measure 特斯拉月销量占比 =
			
			DIVIDE(
			    CALCULATE(
			        SUM('EV销量'[销量]),
			        REMOVEFILTERS('EV销量'[厂商]),
			        'EV销量'[厂商] = "特斯拉中国"
			    ),
			    CALCULATE(
			        SUM('EV销量'[销量]),
			        REMOVEFILTERS('EV销量'[厂商])
			    )
			)
		formatString: 0.00%
		displayFolder: 核心KPI\占比
		lineageTag: 7b94f54a-9c46-4789-bcfb-3d653c20b030

		annotation PBI_FormatHint = {"isGeneralNumber":true}

