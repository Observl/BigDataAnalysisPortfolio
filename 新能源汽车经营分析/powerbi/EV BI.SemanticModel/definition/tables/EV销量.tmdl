	partition EV销量 = m
		mode: import
		source =
				let
				  源 = Excel.Workbook(File.Contents("D:\大数据分析作品集\BigDataAnalysisPortfolio\新能源汽车经营分析\source_data\中国电动车每月销售表.xlsx"), null, true),
				  #"导航 1" = 源{[Item = "Sheet1", Kind = "Sheet"]}[Data],
				  已提升标题 = Table.PromoteHeaders(#"导航 1", [PromoteAllScalars = true]),
				  已更改列类型 = Table.TransformColumnTypes(已提升标题, {{"年份", Int64.Type}, {"月份", Int64.Type}, {"排名", Int64.Type}, {"厂商", type text}, {"车型", type text}, {"销量", Int64.Type}, {"售价（万元）", type text}}, "zh-Hans")
				in
